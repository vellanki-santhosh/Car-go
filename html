<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>2D Car Game Map</title>
    <style>
        body {
            margin: 0;
            background-color: #2c3e50;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            color: white;
            font-family: Arial, sans-serif;
        }
        canvas {
            background-color: #719c59; /* Green Map Background */
            border: 4px solid #ecf0f1;
            box-shadow: 0 0 20px rgba(0,0,0,0.5);
        }
        #instructions {
            position: absolute;
            top: 20px;
        }
    </style>
</head>
<body>

    <div id="instructions">Use <b>W A S D</b> or <b>Arrow Keys</b> to drive your car across the map!</div>
    
    <!-- This is the map where the game happens -->
    <canvas id="gameMap" width="800" height="600"></canvas>

    <script>
        const canvas = document.getElementById("gameMap");
        const ctx = canvas.getContext("2d");

        // --- CAR DESIGN & SETTINGS ---
        const car = {
            x: 400,             // Starting X position on map
            y: 300,             // Starting Y position on map
            width: 64,          // Width of the car (used for drawing the sprite)
            height: 64,         // Height of the car (used for drawing the sprite)
            color: '#e74c3c',   // Fallback color if sprite is not loaded
            speed: 0,           // Current speed
            maxSpeed: 6,        // Maximum driving speed
            reverseSpeed: -3,   // Maximum reverse speed
            acceleration: 0.2,  // How fast it speeds up
            friction: 0.05,     // How fast it slows down when letting go of gas
            angle: 0,           // Direction the car is pointing
            turnSpeed: 0.06,    // How fast the car turns
            sprite: new Image(),
            spriteLoaded: false
        };

        // Load a sprite from the local sprites folder (generated by generate_car_sprites.py)
        car.sprite.src = "sprites/car_sprite_01.png";
        car.sprite.onload = () => { car.spriteLoaded = true; };

        // --- CONTROLS ---
        const keys = {
            forward: false,
            backward: false,
            left: false,
            right: false
        };

        window.addEventListener("keydown", (e) => {
            if(e.key === "ArrowUp" || e.key === "w") keys.forward = true;
            if(e.key === "ArrowDown" || e.key === "s") keys.backward = true;
            if(e.key === "ArrowLeft" || e.key === "a") keys.left = true;
            if(e.key === "ArrowRight" || e.key === "d") keys.right = true;
        });

        window.addEventListener("keyup", (e) => {
            if(e.key === "ArrowUp" || e.key === "w") keys.forward = false;
            if(e.key === "ArrowDown" || e.key === "s") keys.backward = false;
            if(e.key === "ArrowLeft" || e.key === "a") keys.left = false;
            if(e.key === "ArrowRight" || e.key === "d") keys.right = false;
        });

        // --- GAME LOOP & PHYSICS ---
        function update() {
            // 1. Acceleration & Braking
            if (keys.forward) car.speed += car.acceleration;
            if (keys.backward) car.speed -= car.acceleration;

            // 2. Friction (Slow down when no keys are pressed)
            if (car.speed > 0) car.speed -= car.friction;
            if (car.speed < 0) car.speed += car.friction;

            // Stop completely if speed is very low (prevents sliding forever)
            if (Math.abs(car.speed) < car.friction) car.speed = 0;

            // 3. Limit Speed
            if (car.speed > car.maxSpeed) car.speed = car.maxSpeed;
            if (car.speed < car.reverseSpeed) car.speed = car.reverseSpeed;

            // 4. Steering (Only turn if moving)
            if (car.speed !== 0) {
                // Reverse steering direction if going backward to feel natural
                const direction = car.speed > 0 ? 1 : -1; 
                
                if (keys.left) car.angle -= car.turnSpeed * direction;
                if (keys.right) car.angle += car.turnSpeed * direction;
            }

            // 5. Move the car forward based on its angle
            car.x += Math.sin(car.angle) * car.speed;
            car.y -= Math.cos(car.angle) * car.speed;

            // 6. Draw everything
            draw();

            // Loop the game at 60 Frames Per Second
            requestAnimationFrame(update);
        }

        // --- DRAWING THE MAP AND CAR ---
        function draw() {
            // Clear the map for the next frame
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            // Draw a basic road/map feature (Optional)
            ctx.fillStyle = '#95a5a6';
            ctx.fillRect(300, 0, 200, 600); // A gray road down the middle
            ctx.setLineDash([20, 20]);
            ctx.beginPath();
            ctx.moveTo(400, 0);
            ctx.lineTo(400, 600);
            ctx.strokeStyle = "white";
            ctx.lineWidth = 4;
            ctx.stroke();

            // Save the default canvas state
            ctx.save();

            // Move the canvas origin to the car's position and rotate it
            ctx.translate(car.x, car.y);
            ctx.rotate(car.angle);

            // Draw the car (sprite if loaded, otherwise fallback to simple shape)
            if (car.spriteLoaded) {
                ctx.drawImage(
                    car.sprite,
                    -car.width / 2,
                    -car.height / 2,
                    car.width,
                    car.height
                );
            } else {
                ctx.fillStyle = car.color;
                ctx.shadowColor = 'rgba(0,0,0,0.5)';
                ctx.shadowBlur = 10;
                ctx.fillRect(-car.width / 2, -car.height / 2, car.width, car.height);

                // Draw Windshield
                ctx.fillStyle = '#34495e';
                ctx.fillRect(-car.width / 2 + 2, -car.height / 2 + 8, car.width - 4, 10);

                // Draw Headlights
                ctx.fillStyle = '#f1c40f';
                ctx.fillRect(-car.width / 2 + 2, -car.height / 2 - 2, 6, 4); // Left light
                ctx.fillRect(car.width / 2 - 8, -car.height / 2 - 2, 6, 4);  // Right light
            }

            // Restore canvas to default state
            ctx.restore();
        }

        // Start the game!
        update();
    </script>
</body>
</html>